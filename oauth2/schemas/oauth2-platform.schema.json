{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://darkedges.au/schemas/pingfederate/oauth2-platform-v1alpha1.json",
  "title": "PingFederate OAuth2 platform catalog",
  "type": "object",
  "additionalProperties": false,
  "required": ["apiVersion", "kind", "spec"],
  "properties": {
    "apiVersion": { "const": "pingfederate.oauth2/v1alpha1" },
    "kind": { "const": "OAuth2PlatformCatalog" },
    "spec": {
      "type": "object",
      "additionalProperties": false,
      "required": ["approvedScopes", "externalReferences", "accessTokenManagers", "accessTokenMappings", "oidcPolicies", "tokenExchangePolicies", "tokenExchangeGeneratorMappings"],
      "properties": {
        "approvedScopes": { "$ref": "#/$defs/uniqueStrings" },
        "externalReferences": {
          "type": "object",
          "additionalProperties": false,
          "required": ["tokenProcessors", "tokenGenerators"],
          "properties": {
            "tokenProcessors": { "$ref": "#/$defs/referenceMap" },
            "tokenGenerators": { "$ref": "#/$defs/referenceMap" },
            "dataSources": { "$ref": "#/$defs/referenceMap" }
          }
        },
        "accessTokenManagers": {
          "type": "array", "items": { "$ref": "#/$defs/accessTokenManager" }
        },
        "accessTokenMappings": {
          "type": "array", "items": { "$ref": "#/$defs/accessTokenMapping" }
        },
        "oidcPolicies": {
          "type": "array", "items": { "$ref": "#/$defs/oidcPolicy" }
        },
        "tokenExchangePolicies": {
          "type": "array", "items": { "$ref": "#/$defs/tokenExchangePolicy" }
        },
        "tokenExchangeGeneratorMappings": {
          "type": "array", "items": { "$ref": "#/$defs/tokenExchangeGeneratorMapping" }
        }
      }
    }
  },
  "$defs": {
    "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]{0,63}$" },
    "uniqueStrings": { "type": "array", "uniqueItems": true, "items": { "type": "string", "minLength": 1 } },
    "referenceMap": { "type": "object", "additionalProperties": { "type": "string", "minLength": 1 } },
    "attributeContract": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name"],
        "properties": { "name": { "type": "string", "minLength": 1 }, "multiValued": { "type": "boolean" } }
      }
    },
    "fulfillment": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "additionalProperties": false, "required": ["source", "value"],
        "properties": {
          "source": {
            "type": "object", "additionalProperties": false, "required": ["type"],
            "properties": {
              "type": { "enum": ["TEXT", "TOKEN", "CONTEXT", "REQUEST", "OAUTH_PERSISTENT_GRANT", "SUBJECT_TOKEN", "ACTOR_TOKEN", "TOKEN_EXCHANGE_PROCESSOR_POLICY", "MAPPED_ATTRIBUTES"] },
              "id": { "type": "string", "minLength": 1 }
            }
          },
          "value": { "type": "string" }
        }
      }
    },
    "configuration": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "fields": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "value"],
            "properties": { "name": { "type": "string" }, "value": { "type": "string" } }
          }
        },
        "sensitiveFields": {
          "type": "array", "items": {
            "type": "object", "additionalProperties": false, "required": ["name", "secretRef"],
            "properties": { "name": { "type": "string" }, "secretRef": { "$ref": "#/$defs/key" } }
          }
        }
      }
    },
    "accessTokenManager": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "managerId", "name", "profile", "attributeContract", "configuration"],
      "properties": {
        "key": { "$ref": "#/$defs/key" }, "managerId": { "type": "string", "pattern": "^[A-Za-z0-9]{1,32}$" },
        "name": { "type": "string", "minLength": 1 }, "profile": { "enum": ["jwt", "reference"] },
        "attributeContract": { "$ref": "#/$defs/attributeContract" }, "configuration": { "$ref": "#/$defs/configuration" },
        "resourceUris": { "$ref": "#/$defs/uniqueStrings" }
      }
    },
    "accessTokenMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "accessTokenManager", "context", "attributeContractFulfillment"],
      "properties": {
        "key": { "$ref": "#/$defs/key" }, "accessTokenManager": { "$ref": "#/$defs/key" },
        "context": {
          "type": "object", "additionalProperties": false, "required": ["type", "contextRef"],
          "properties": { "type": { "type": "string", "minLength": 1 }, "contextRef": { "type": "string", "minLength": 1 } }
        },
        "attributeContractFulfillment": { "$ref": "#/$defs/fulfillment" }
      }
    },
    "oidcPolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "policyId", "name", "accessTokenManager", "attributeContract", "attributeContractFulfillment"],
      "properties": {
        "key": { "$ref": "#/$defs/key" }, "policyId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }, "accessTokenManager": { "$ref": "#/$defs/key" },
        "attributeContract": { "$ref": "#/$defs/attributeContract" },
        "attributeContractFulfillment": { "$ref": "#/$defs/fulfillment" },
        "scopeAttributeMappings": { "type": "object", "additionalProperties": { "$ref": "#/$defs/uniqueStrings" } },
        "idTokenLifetimeMinutes": { "type": "integer", "minimum": 1, "maximum": 60 }
      }
    },
    "tokenExchangePolicy": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "policyId", "name", "processorMappings"],
      "properties": {
        "key": { "$ref": "#/$defs/key" }, "policyId": { "type": "string", "minLength": 1 },
        "name": { "type": "string", "minLength": 1 }, "actorTokenRequired": { "type": "boolean" },
        "processorMappings": {
          "type": "array", "minItems": 1, "items": {
            "type": "object", "additionalProperties": false,
            "required": ["subjectTokenType", "subjectTokenProcessor", "attributeContractFulfillment"],
            "properties": {
              "subjectTokenType": { "type": "string", "minLength": 1 },
              "subjectTokenProcessor": { "$ref": "#/$defs/key" },
              "actorTokenType": { "type": "string", "minLength": 1 },
              "actorTokenProcessor": { "$ref": "#/$defs/key" },
              "attributeContractFulfillment": { "$ref": "#/$defs/fulfillment" }
            }
          }
        }
      }
    },
    "tokenExchangeGeneratorMapping": {
      "type": "object", "additionalProperties": false,
      "required": ["key", "policy", "tokenGenerator", "attributeContractFulfillment"],
      "properties": {
        "key": { "$ref": "#/$defs/key" }, "policy": { "$ref": "#/$defs/key" },
        "tokenGenerator": { "$ref": "#/$defs/key" },
        "attributeContractFulfillment": { "$ref": "#/$defs/fulfillment" }
      }
    }
  }
}
