aws_region        = "ap-southeast-2"
bucket_name       = "replace-with-globally-unique-pingfederate-state-bucket"
github_repository = "your-org/pingfeddeploy"
vault_address     = "https://vault.example.com"

pingfederate_hosts = {
  development = "pingfederate-dev.internal.example.com"
  staging     = "pingfederate-staging.internal.example.com"
  production  = "pingfederate.internal.example.com"
}

# Temporary escape hatch for self-signed certificates. Keep false in production.
pingfederate_insecure_trust_all_tls = false

# Set this when the AWS account already has the GitHub Actions OIDC provider.
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

# Repositories using GitHub immutable OIDC subjects must set the prefix returned
# by: gh api repos/OWNER/REPOSITORY/actions/oidc/customization/sub
# github_oidc_subject_prefix = "repo:your-org@123456/pingfeddeploy@789012"

# Set true only when the jwt auth path does not already exist in Vault.
manage_vault_jwt_backend = false

# Set true only when this Terraform configuration should create Vault's kv mount.
manage_kv_mount = false

tags = {
  Environment = "shared"
  Owner       = "identity-platform"
}
