aws_region        = "ap-southeast-2"
bucket_name       = "replace-with-globally-unique-pingfederate-state-bucket"
github_repository = "your-org/pingfeddeploy"
vault_address     = "https://vault.example.com"

# Set this when the AWS account already has the GitHub Actions OIDC provider.
# github_oidc_provider_arn = "arn:aws:iam::123456789012:oidc-provider/token.actions.githubusercontent.com"

# Set true only when this Terraform configuration should create Vault's kv mount.
manage_kv_mount = false

tags = {
  Environment = "shared"
  Owner       = "identity-platform"
}
